# Copy this file to  .env  and fill in your own read-only Banner connection.
# The .env file is never committed. Use a READ-ONLY account: every query this tool
# runs is a SELECT, and a read-only account guarantees it can never be anything else.

BANNER_HOST=your-banner-db-host
BANNER_PORT=1521
BANNER_SERVICE=YOUR_SERVICE_NAME
BANNER_USER=your_readonly_user
BANNER_PASS=your_password

# The prefix your non-human Banner accounts share (service / integration accounts).
# They hold access no person uses, so counting them inflates every "people who can
# reach it" number on the map. Left unset, nothing is excluded and the counts run high.
# BCM_SERVICE_ACCOUNT_PREFIX=SVC

# Optional: only if the tool cannot find your Oracle Instant Client on its own.
# Point it at the folder that holds oci.dll (the same client SQL Developer uses).
# ORACLE_CLIENT_DIR=C:\oracle\instantclient
